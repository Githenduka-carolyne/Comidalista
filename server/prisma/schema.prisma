generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id           String @id @default(uuid())
  firstName    String
  lastName     String
  emailAddress String @unique
  phoneNumber  Int    @unique
  password     String

  @@map("users_table")
}

model Foods {
  type     String
  price    Int
  category String
  id       Int    @id @default(autoincrement())

  @@map("foods_table")
}

model Tables {
  id    Int    @id @default(autoincrement())
  table Int
  time  String
  date  String

  @@map("bookings_table")
}
